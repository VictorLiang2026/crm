# 个人 CRM 云函数环境变量（仅占位，不填真值）
# 部署前在 CloudBase 控制台「云函数 → 函数配置」中注入以下变量。
# 共享集群 PostgreSQL 无 PG 协议直连凭证，数据访问走 node-sdk 4.x 的 app.rdb()（免密），
# 不启用 VPC，不填 VPC ID / 子网，不需要任何 PG_* 变量。

# CloudBase 环境 ID
TCB_ENV=

# AI 模型（仅 ai_recommend / ai_parse 使用，通过 app.ai().createModel('cloudbase') 调用）
AI_MODEL=hy3

# Isolated CRM Knowledge MCP OAuth service. Values are configured in CloudBase, never committed here.
# assistant only: existing server-only DB API key. knowledge_mcp never receives this key.
# Both functions: separate random 32+ character HMAC secret.
# CRM_KNOWLEDGE_MCP_RESOURCE_URL=https://<verified-https-service-domain>/mcp/knowledge
# CRM_KNOWLEDGE_MCP_HMAC_KEY=
# knowledge_mcp only: dedicated server API key (service_role; bypasses RLS). Code uses it only to invoke assistant.
# CRM_KNOWLEDGE_MCP_CLOUDBASE_API_KEY=
# knowledge_mcp only: exact HTTPS OAuth issuer and static consent-page URL.
# CRM_KNOWLEDGE_MCP_ISSUER_URL=https://<verified-https-service-domain>
# CRM_KNOWLEDGE_MCP_CONSENT_URI=https://<verified-static-domain>/crm/oauth-consent.html
