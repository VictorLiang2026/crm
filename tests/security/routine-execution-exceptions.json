{
  "routines": [
    {
      "id": "routine:crm_knowledge_gpt_queue_v1(p_actor_uid text, p_table text, p_id bigint, p_expected_updated_at timestamp with time zone)",
      "expectedDetail": {
        "anon_execute": false,
        "service_execute": false,
        "security_definer": false,
        "authenticated_execute": false
      },
      "reason": "Revoked 2026-11-02 after the summary-only knowledge flow replaced this queue RPC. The function remains for compatibility but is absent from the assistant RPC allowlist and has no service_role execute grant."
    },
    {
      "id": "routine:crm_knowledge_ocr_input_v1(p_source_id bigint, p_upload_id uuid)",
      "expectedDetail": {
        "anon_execute": true,
        "service_execute": false,
        "security_definer": true,
        "authenticated_execute": false
      },
      "reason": "Authorized 2026-10-27 for knowledge image OCR. The CloudBase ai_parse function can execute this SECURITY DEFINER routine only for the matching source ID and random upload capability while the source is extracting; it returns only PNG/JPEG/WEBP bytes and grants no table access. Revoke after replacing the OCR handoff with a server-authenticated path."
    },
    {
      "id": "routine:pmc18_collect_once_v1()",
      "expectedDetail": {
        "anon_execute": true,
        "authenticated_execute": false,
        "security_definer": true,
        "service_execute": false
      },
      "reason": "The existing pmc18_observer Cloud Function uses app.rdb() as anon. On 2026-10-19, revoking anon and granting service_role caused its real collect invocation to fail with permission denied; restoring anon made it return the already-collected 20-metric snapshot. Keep this exact ACL until PM18 has an independently approved service_role caller migration."
    },
    {
      "id": "routine:crm_device_gateway_v1(p_op text, p_uid text, p_fingerprint text, p_args jsonb)",
      "expectedDetail": {
        "anon_execute": true,
        "service_execute": false,
        "security_definer": true,
        "authenticated_execute": false
      },
      "reason": "Server SDK only: requires signed anon role without a subject. Rejects client JWTs; membership and device state are checked per operation. Cannot approve devices or change members."
    },
    {
      "id": "routine:crm_device_state_changed_v1()",
      "expectedDetail": {
        "anon_execute": false,
        "service_execute": false,
        "security_definer": false,
        "authenticated_execute": false
      },
      "reason": "Trigger only; revocation invalidates outstanding challenges. No API execution grant."
    },
